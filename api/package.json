{
  "name": "linkedin-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:extension && tsx watch src/index.ts",
    "build": "tsc",
    "start": "npm run build:extension && node dist/index.js",
    "build:extension": "node scripts/package-extension.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "auth:generate": "better-auth generate --output src/db/auth-schema.ts",
    "typecheck": "tsc --noEmit",
    "check:defaults": "tsx scripts/check-limit-defaults.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.2",
    "@hono/node-server": "^1.13.7",
    "better-auth": "^1.2.7",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "archiver": "^7.0.1",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
